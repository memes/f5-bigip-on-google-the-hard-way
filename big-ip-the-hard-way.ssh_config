# SSH configuration for BIG-IP on Google Cloud the hard way that uses gcloud IAP tunnel to transport SSH traffic to
# BIG-IP VE instances before and after NIC-swap and reboot. The file can be used as is with
# `-F big-ip-the-hard-way.ssh_config` or merged into ~/.ssh/config.
#
# Source: https://github.com/memes/f5-bigip-on-google-the-hard-way/blob/main/big-ip-the-hard-way.ssh_config

# Access to management IP addresses on eth1 via Google IAP tunnel (post reboot)
Host 10.100.0.101 10.100.0.102
    User admin
    CheckHostIP no
    IdentitiesOnly yes
    IdentityFile big-ip-the-hard-way.key
    PasswordAuthentication no
    PreferredAuthentications publickey
    # Use a separate known hosts file to avoid polluting ~/.ssh/known_hosts with ephemeral values
    UserKnownHostsFile big-ip-the-hard-way.known_hosts
    # Proxy through IAP TCP tunnel on management network
    ProxyCommand gcloud compute start-iap-tunnel %h %p --listen-on-stdin --dest-group big-ip-the-hard-way --region us-west1 --network big-ip-the-hard-way-mgt

# Access to BIG-IP external data-plane IP addresses on eth0 via Google IAP tunnel (prior to reboot)
Host 10.0.0.101 10.0.0.102
    User admin
    CheckHostIP no
    IdentitiesOnly yes
    IdentityFile big-ip-the-hard-way.key
    PasswordAuthentication no
    PreferredAuthentications publickey
    # Use a separate known hosts file to avoid polluting ~/.ssh/known_hosts with ephemeral values
    UserKnownHostsFile big-ip-the-hard-way.known_hosts
    # Proxy through IAP TCP tunnel on external network
    ProxyCommand gcloud compute start-iap-tunnel %h %p --listen-on-stdin --dest-group big-ip-the-hard-way --region us-west1 --network big-ip-the-hard-way-ext
